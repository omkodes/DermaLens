<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="72"
    android:viewportHeight="72">

    <!-- Orb body: diagonal mint-to-green gradient -->
    <path android:pathData="M36,0 a36,36 0 1,0 0,72 a36,36 0 1,0 0,-72">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="72"
                android:endY="72">
                <item android:offset="0" android:color="#9FE1CB" />
                <item android:offset="1" android:color="#0E7F5C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft highlight -->
    <group
        android:pivotX="27"
        android:pivotY="24"
        android:rotation="-30">
        <path
            android:pathData="M12,24 a15,9 0 1,0 30,0 a15,9 0 1,0 -30,0"
            android:fillColor="#4DFFFFFF" />
    </group>

    <!-- Lens ring -->
    <path
        android:pathData="M27,38 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />
</vector>
